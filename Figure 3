rm(list = ls())
Myeloid <- readRDS("E:/胃癌/20250619/data/Myeloid.rds")

Macrophage=subset(Myeloid,cluster=="M03_TAM_C1QA")

Macrophage=subset(Macrophage,Site%in%c("LN","MLN","MMLN"))

# 每个样本×时间点×细胞类型汇总
pb <- AggregateExpression(
  Macrophage,
  group.by = c("orig.ident", "Site"),
  assays = "RNA",
  slot = "counts"
)
counts <- pb$RNA
# 再用 DESeq2 / edgeR 做 time ~ condition


meta <- data.frame(
  sample_time = colnames(counts),
  time = sapply(strsplit(colnames(counts), "_"), `[`, 2),
  sample = sapply(strsplit(colnames(counts), "_"), `[`, 1)
)

meta$time_num <- meta$time
meta$time_num <- gsub("MMLN",2,meta$time_num)
meta$time_num <- gsub("MLN",1,meta$time_num)
meta$time_num <- gsub("LN",0,meta$time_num)
meta$time_num =as.numeric(meta$time_num )

colnames(counts)=meta$sample
rownames(meta)=meta$sample
library(DESeq2)
dds <- DESeqDataSetFromMatrix(countData = counts, colData = meta, design = ~ time_num)

# 3. 运行 LRT 检验 (寻找随时间变化的基因)
dds_lrt <- DESeq(dds, test = "LRT", reduced = ~ 1)
res_lrt <- results(dds_lrt)

# 筛选显著基因 (如 padj < 0.05)
sig_genes <- rownames(res_lrt[which(res_lrt$padj < 0.05), ])

# 4. 获取标准化表达量并准备热图数据
vsd <- varianceStabilizingTransformation(dds_lrt, blind = FALSE)
exp_matrix <- assay(vsd)[sig_genes, ]
exp_matrix
# 按时间点取平均值，方便观察趋势
avg_exp <- t(apply(exp_matrix, 1, function(x) tapply(x, meta$time_num, mean)))
# Z-score 标准化
scaled_exp <- t(scale(t(avg_exp)))
library(ComplexHeatmap)
library(circlize)
# 5. 绘图


# 设定热图颜色
col_fun = colorRamp2(c(-2, 0, 2), c("#007891", "white", "#b2182b"))

# 绘制热图并保存聚类结果
# 假设我们想分成 4 个簇（您可以根据热图实际效果调整 km 数）
set.seed(123) # 保证聚类结果可重复


# 创建一个向量，非 selected_genes 的行名设置为空字符串
# 原来的 50 个基因
selected_genes <- c(
  # 炎症 / 免疫调控
  "IL1B","IL1RAP","IRF5","RELA","STAT3","BIRC3","CASP4",
  
  # 趋化 / 肿瘤相关免疫
  "CCL24","CCL14","ICAM1","ADGRE5","CD33","CD93","LGALS3",
  
  # 转录调控 / 应激反应
  "ATF3","ATF4","HES1","KLF4","KLF9","CREM",
  
  # 代谢 / 缺氧
  "PFKFB3","LDHA","LDHB","EGLN1","EGLN2","NFE2L2","SREBF1",
  
  # 吞噬 / 溶酶体 / 膜囊泡运输
  "CTSH","RAB7A","RAB5A","APP",
  
  "TPT1","CUX1"
)
# 新的 TF 基因
key_tf <- c("RELA","STAT3","IRF5","ATF3","CREM","KLF4","KLF9","HES1","CUX1","CREM",
            "NFE2L2","SREBF1","RUNX1","EP300","SP1","BCL6","MECP2","SUMO2")

selected_genes=unique(c(selected_genes,key_tf))
# 合并并去重
#final_genes <- unique(c(selected_genes, tf_genes))

row_labels <- rownames(scaled_exp)
row_labels[!rownames(scaled_exp) %in% selected_genes] <- ""  # 非50个基因行名置空


library(ComplexHeatmap)
library(circlize)

# 假设 final_genes 是你要高亮的 50+15 基因
key_genes <- selected_genes

# 创建标注对象
row_anno <- rowAnnotation(
  mark = anno_mark(
    at = which(rownames(scaled_exp) %in% key_genes),
    labels = rownames(scaled_exp)[rownames(scaled_exp) %in% key_genes],
    side = "right",
    labels_gp = gpar(fontsize = 8)
  )
)

# 绘制 heatmap
ht <- Heatmap(scaled_exp, 
              name = "Z-score",
              column_title = "Macrophages Gene Expression Over Time",
              col = col_fun,
              show_row_names = FALSE,   # 关闭默认行名
              cluster_columns = FALSE,
              row_km = 4,
              row_title = "Cluster %s",
              column_names_side = "bottom"
)

# 合并标注
ht <- ht + row_anno

draw(ht)

pdf("./Fig3D.pdf",7,7)
print(ht)
